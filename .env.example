APP_NAME=Meridian
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meridian
DB_USERNAME=root
DB_PASSWORD=

# Cookie consent: raise CONSENT_VERSION to ask every visitor again.
# CONSENT_THROTTLE is accept/decline requests per minute per IP (default 30).
CONSENT_VERSION=1
CONSENT_THROTTLE=30

# Admin portal: the seeded admin is admin@meridian.test. Set a real password
# anywhere that is not your own machine. DEMO_DATA seeds 30 days of fake
# consents outside local (it is always on for local).
ADMIN_PASSWORD=password
DEMO_DATA=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Live admin overview. Off by default: `log` writes broadcasts to the log and
# the page behaves as before. To turn it on, set BROADCAST_CONNECTION=reverb
# and run `php artisan dev` (it starts Reverb and a queue worker). Broadcasts
# are queued, so QUEUE_CONNECTION needs a worker. The values below are for your
# own machine only. REVERB_HOST, PORT and SCHEME are where both PHP and the
# browser reach the server; REVERB_SERVER_* is what it listens on.
BROADCAST_CONNECTION=log
REVERB_APP_ID=meridian
REVERB_APP_KEY=meridian-local-key
REVERB_APP_SECRET=meridian-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
